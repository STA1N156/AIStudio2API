# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# 生成的图片、音频、视频链接使用的对外地址，例如 https://example.com；留空时取请求的访问地址
# 经 Zeabur 内网或 New API 等中转服务调用时必须填写，否则链接会指向内网地址
PUBLIC_BASE_URL=

# 本地 API 认证密钥，多个 key 用逗号分隔
PROXY_API_KEY=

# 管理程序启动后自动启动生成服务，修改后重启程序生效
AUTO_START=false

# 保存公开 API 的 POST 请求与响应正文，各截断到 64 KiB，只保留最近 1000 条，保存后立即生效
REQUEST_BODY_LOG=false

# 空回复先按现有规则重试，仍为空则返回 400；关闭后直接保留 200 空结果，保存后立即生效
EMPTY_OUTPUT_ERROR=true

# 控制台日志默认关闭；它与 EMPTY_OUTPUT_ERROR 均关闭时暂停新增用量和请求历史，不删除旧记录
# 任意一个开启即恢复记录；面板实时日志和下方的文件日志开关保持独立
LOG_CONSOLE=false

# 同时把服务日志写入 runtime/logs/，单文件 10 MB 轮转，保存后立即生效
LOG_FILE=true

# 日志目录总量上限（MB），超出时删除最旧的文件，不小于 20
LOG_MAX_TOTAL_MB=500

# 管理控制台登录，修改后重启程序生效
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理，多个代理用逗号分隔组成代理池
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=30m

# 常驻预热账户数
WARM_WORKER_LIMIT=20

# 高峰期最多同时运行的 Worker 数
MAX_ACTIVE_WORKERS=50

# 同时冷启动的 Worker 数，预热与按需扩容共用，Camoufox 和 Go 后端均生效
WARM_STARTUP_CONCURRENCY=5

# 40 GB 容器可在平台环境变量设置 GOMEMLIMIT=32GiB（Go 运行时软上限）。
# 必须通过进程环境传入，仅写入本程序读取的 .env 文件不会生效；不是硬内存上限。
# 未设置 GOGC 时程序默认 GOGC=50，以少量 CPU 换更低的峰值内存；同样只认进程环境。

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# 账户选择策略：round-robin 或 fill-first
ROUTING_STRATEGY=round-robin

# 生成请求使用的上游通道：playground、build，逗号分隔
UPSTREAM_CHANNELS=playground,build

# 客户端模型名到目录模型 ID 的映射，每项写成 别名:模型 ID，逗号分隔多项
MODEL_MAPPING=

# 非流式请求先使用 Build 原生单次调用，不可用时回退流式并记录原因
BUILD_NATIVE_NONSTREAM=true

# WAA 后端：camoufox 使用 Camoufox 页面，go 在服务进程内运行
WAA_BACKEND=camoufox

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false
